{
  "name": "@civilization/deepseek-harness-base-ui",
  "version": "0.2.0",
  "description": "Cordis runtime watchdog and recovery controls for DeepSeek Harness Web",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civilization-os/deepseek-harness-plugins-base-ui.git"
  },
  "homepage": "https://github.com/civilization-os/deepseek-harness-plugins-base-ui#readme",
  "bugs": "https://github.com/civilization-os/deepseek-harness-plugins-base-ui/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/setup.js",
    "web": "node scripts/web.js",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "esbuild": "^0.28.2",
    "react": "^19.2.8"
  }
}
